# Native OpenWrt env/kernel-config overrides. These are Linux symbols, not
# CONFIG_PACKAGE selections: =y puts the code in the compressed FIT kernel.
# Keep the corresponding kmod packages selected for dependency metadata.

# Small, commonly used TUN and socket diagnostics (including Mihomo support).
CONFIG_TUN=y
CONFIG_INET_DIAG=y
CONFIG_INET_TCP_DIAG=y
CONFIG_INET_UDP_DIAG=y
CONFIG_INET_RAW_DIAG=y

# nftables socket/transparent proxy support and its IPv4/IPv6 dependencies.
CONFIG_NFT_SOCKET=y
CONFIG_NFT_TPROXY=y
CONFIG_NF_SOCKET_IPV4=y
CONFIG_NF_SOCKET_IPV6=y
CONFIG_NF_TPROXY_IPV4=y
CONFIG_NF_TPROXY_IPV6=y

# Shared firewall infrastructure: leave other nft expressions as modules.
CONFIG_NF_TABLES=y
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_LIBCRC32C=y
CONFIG_CRYPTO_CRC32C=y
