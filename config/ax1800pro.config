# JDCloud AX1800 Pro / Arthur (RE-SS-01), eMMC storage.
CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq60xx=y
CONFIG_TARGET_qualcommax_ipq60xx_DEVICE_jdcloud_re-ss-01=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_JSON_OVERVIEW_IMAGE_INFO=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_TARGET_MULTI_PROFILE is not set
# Keep the target/profile's default drivers and firmware.
# The qualcommax profile supplies e2fsprogs, kmod-fs-ext4, and losetup.
# The local fstools patch formats the eMMC-backed overlay as ext4.
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_losetup=y

# Cache compilation across Actions runs; OpenWrt stores it in .ccache.
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# Native LuCI modules without collection packages or an extra theme.
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-proto-ipv6=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_rpcd-mod-rrdns=y
CONFIG_PACKAGE_uhttpd=y
CONFIG_PACKAGE_uhttpd-mod-ubus=y
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-light is not set
# CONFIG_PACKAGE_luci-ssl is not set
# CONFIG_PACKAGE_luci-theme-bootstrap is not set
# CONFIG_PACKAGE_luci-app-package-manager is not set

# The release fragment selects the package manager and HTTPS provider.
CONFIG_PACKAGE_ca-bundle=y

# Argon is the only third-party package. Dark mode is set in files/.
CONFIG_PACKAGE_luci-theme-argon=y
# CONFIG_PACKAGE_luci-app-argon-config is not set
CONFIG_LUCI_LANG_zh_Hans=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y

# No optional services are added to the router's normal base packages.
# CONFIG_PACKAGE_luci-app-ddns is not set
# CONFIG_PACKAGE_luci-app-upnp is not set

# Keep the upstream qca-nss-dp Ethernet driver; do not add NSS offload.
